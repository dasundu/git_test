# App connection. With Neon use the POOLED string (host contains "-pooler") + ?sslmode=require
DATABASE_URL="postgresql://truck:truck@localhost:5432/truckmarket?schema=public"
# Used by Prisma migrations. With Neon use the DIRECT (non-pooled) string. Locally it is the same as DATABASE_URL.
DIRECT_URL="postgresql://truck:truck@localhost:5432/truckmarket?schema=public"
JWT_SECRET="dev-secret-change-me-in-production"
PORT=4000
WEB_URL="http://localhost:3000"
API_URL="http://localhost:4000"
# Optional SMTP (emails are logged to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Truck Marketplace <no-reply@truckmarket.ph>"
# Optional Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@truckmarket.ph"
# Seed admin
ADMIN_EMAIL="admin@truckmarket.ph"
ADMIN_PASSWORD="ChangeMe123!"
